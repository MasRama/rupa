# Discord application (https://discord.com/developers/applications)
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Optional: deploy commands to one test server (instant) instead of globally
DISCORD_GUILD_ID=

# SQLite database file
DATABASE_PATH=./data/rupa.db

# trace | debug | info | warn | error | fatal
LOG_LEVEL=info
NODE_ENV=development

# Usage statistics (docs/stats.md)
STATS_ENABLED=true
STATS_RETENTION_DAYS=90
# Stores user ids; needs a privacy policy under Discord's Developer Policy
STATS_TRACK_USERS=false

# Web dashboard (docs/dashboard.md); off while DASHBOARD_PORT is empty
DASHBOARD_PORT=
DASHBOARD_URL=http://localhost:3000
DISCORD_CLIENT_SECRET=
# Extra owners besides the application owner or team, comma-separated user ids
DASHBOARD_OWNER_IDS=
