{
  "name": "rupa",
  "version": "0.1.0",
  "private": true,
  "description": "Feature-first Discord bot kit. Build by feature, route every interaction, own your SQLite.",
  "license": "MIT",
  "author": "MasRama",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MasRama/rupa.git"
  },
  "bugs": {
    "url": "https://github.com/MasRama/rupa/issues"
  },
  "homepage": "https://github.com/MasRama/rupa#readme",
  "keywords": [
    "discord",
    "discord-bot",
    "discord.js",
    "typescript",
    "sqlite",
    "starter-kit"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "npm@10.9.8",
  "main": "dist/app/main.js",
  "scripts": {
    "dev": "tsx watch src/app/main.ts",
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "start": "node dist/app/main.js",
    "rupa": "tsx src/cli/index.ts",
    "migrate": "tsx src/cli/index.ts migrate",
    "migrate:status": "tsx src/cli/index.ts migrate:status",
    "deploy": "tsx src/cli/index.ts deploy",
    "deploy:plan": "tsx src/cli/index.ts deploy --plan",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "discord.js": "^14.27.0",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.5",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "tsc-alias": "^1.9.9",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.0.0",
    "vitest": "^5.0.5"
  }
}
